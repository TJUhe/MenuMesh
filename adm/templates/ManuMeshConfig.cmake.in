@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(MANUMESH_EIGEN_INCLUDE_DIR
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/manumesh/thirdParty/eigen/include"
)
if(NOT TARGET Eigen3::Eigen)
  if(EXISTS "${MANUMESH_EIGEN_INCLUDE_DIR}/Eigen/Core")
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${MANUMESH_EIGEN_INCLUDE_DIR}"
    )
  else()
    find_dependency(Eigen3 3.3 NO_MODULE)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ManuMeshTargets.cmake")

set(MANUMESH_SHARED @MANUMESH_BUILD_SHARED_LIBRARY@)
set(MANUMESH_RUNTIME_DIR
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@"
)
set(MANUMESH_MSVC_PROPS "")
if(@MANUMESH_HAS_MSVC_PROPS@)
  set(MANUMESH_MSVC_PROPS
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/manumesh/msvc/ManuMesh.props"
  )
endif()

function(manumesh_copy_runtime_dependencies target)
  if(WIN32 AND MANUMESH_SHARED AND TARGET ManuMesh::manumesh)
    file(GLOB MANUMESH_RUNTIME_DLLS
      "${MANUMESH_RUNTIME_DIR}/*.dll"
    )
    if(MANUMESH_RUNTIME_DLLS)
      add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different
          ${MANUMESH_RUNTIME_DLLS}
          "$<TARGET_FILE_DIR:${target}>"
        COMMENT "正在将 ManuMesh 和编译器运行时库复制到 ${target} 旁边"
        COMMAND_EXPAND_LISTS
        VERBATIM
      )
    else()
      message(FATAL_ERROR
        "在 '${MANUMESH_RUNTIME_DIR}' 未找到 ManuMesh 运行时 DLL。"
      )
    endif()
  endif()
endfunction()
