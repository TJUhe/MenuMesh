      "args": ["/d", "/c", "call \"D:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 && cmake --build build/msvc-ninja-release --target linequadrics --parallel 2"],
