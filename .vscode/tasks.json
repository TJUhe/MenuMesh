      "label": "run: full demo data",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/linequadrics.exe",
      "args": ["demo", "--samples", "1000"],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "run: feature validation",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/linequadrics.exe",
      "args": ["validate-features", "--ratio", "0.20", "--n", "96", "--samples", "1000"],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "run: external validation",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/linequadrics.exe",
      "args": ["validate-external", "--ratio", "0.25", "--samples", "800"],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "run: large validation 100 stl",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_large_validation_100.ps1",
        "-BuildDir",
        "build/mingw-ninja-release",
        "-OutputDir",
        "examples/output/large_validation_100",
        "-Samples",
        "80"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "open: large validation output",
      "type": "shell",
      "command": "explorer.exe",
      "args": ["${workspaceFolder}\\examples\\output\\large_validation_100"],
      "problemMatcher": []
    },
    {
      "label": "open: large validation summary",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "start", "", "${workspaceFolder}\\examples\\output\\large_validation_100\\summary.csv"],
      "problemMatcher": []
    },
