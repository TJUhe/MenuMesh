        "stopOnFailure": false
      }
    },
    {
      "name": "vs2019-release-external",
      "displayName": "Test VS2019 Release - external meshes",
      "configurePreset": "vs2019-release",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "external"
        }
      },
      "output": {
        "outputOnFailure": true
      },
