  "testPresets": [
    {
      "name": "vs2019-debug-unit",
      "configurePreset": "vs2019-debug",
      "configuration": "Debug",
      "filter": {
        "exclude": {
          "label": "performance|external"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
