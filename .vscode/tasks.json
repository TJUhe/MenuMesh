{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure: mingw+ninja release",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build/mingw-ninja-release", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_CXX_COMPILER=g++", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
      "problemMatcher": []
    },
    {
      "label": "build: mingw+ninja release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--target", "linequadrics", "--parallel", "2"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "build: mingw+ninja release all",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--parallel", "2"],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
