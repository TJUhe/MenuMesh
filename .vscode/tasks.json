    {
      "id": "demoMesh",
      "type": "pickString",
      "description": "Demo mesh",
      "default": "tests/data/feature_fixtures/coaxial_hole_plate.obj",
      "options": [
        "tests/data/feature_fixtures/coaxial_hole_plate.obj",
        "tests/data/feature_fixtures/elliptical_hole_plate.obj",
        "tests/data/feature_fixtures/boss_pocket_plate.obj",
        "tests/data/feature_fixtures/near_circular_hole_plate.obj",
        "tests/data/external/fandisk_2014.stl",
        "tests/data/external/casting_aimshape_2014.stl"
      ]
    },
    {
      "id": "demoRatio",
      "type": "pickString",
      "description": "Target face ratio",
      "default": "0.25",
      "options": ["0.80", "0.50", "0.25", "0.20", "0.10"]
    },
    {
      "id": "demoRatios",
      "type": "promptString",
      "description": "Ratio sweep list",
      "default": "0.8,0.5,0.25,0.1"
    },
    {
      "id": "demoSamples",
      "type": "pickString",
      "description": "Sampled-distance count",
      "default": "512",
      "options": ["128", "512", "1000", "3000"]
    },
    {
      "id": "demoFeatureAngle",
      "type": "pickString",
      "description": "Feature angle in degrees",
      "default": "25",
      "options": ["15", "25", "35", "45", "179"]
    },
    {
      "id": "msvcGenerator",
      "type": "pickString",
      "description": "MSVC Visual Studio CMake generator",
      "default": "Visual Studio 17 2022",
      "options": [
        "Visual Studio 17 2022",
        "Visual Studio 16 2019",
        "Visual Studio 15 2017"
      ]
    },
    {
      "id": "msvcArch",
      "type": "pickString",
      "description": "MSVC generator platform",
      "default": "x64",
      "options": ["x64", "Win32", "ARM64"]
    },
    {
      "id": "msvcCustomBuildDir",
      "type": "pickString",
      "description": "MSVC custom build directory",
      "default": "build/msvc-custom",
      "options": [
        "build/msvc-custom",
        "build/msvc-vs2022",
        "build/msvc-vs2019",
        "build/msvc-vs2017"
      ]
    },
    {
      "id": "msvcPerformanceTests",
      "type": "pickString",
      "description": "Build performance tests in custom MSVC tree",
      "default": "OFF",
      "options": ["OFF", "ON"]
    }
  ]
