{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure: mingw+ninja debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/mingw-ninja-debug",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=gcc",
        "-DCMAKE_CXX_COMPILER=g++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DMANUMESH_GOOGLETEST_PROVIDER=auto",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=OFF"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: mingw+ninja release",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/mingw-ninja-release",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=gcc",
        "-DCMAKE_CXX_COMPILER=g++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DMANUMESH_GOOGLETEST_PROVIDER=auto",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=OFF"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: mingw+ninja debug performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/mingw-ninja-debug-performance",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=gcc",
        "-DCMAKE_CXX_COMPILER=g++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DMANUMESH_GOOGLETEST_PROVIDER=auto",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=ON"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: mingw+ninja release performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/mingw-ninja-release-performance",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=gcc",
        "-DCMAKE_CXX_COMPILER=g++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DMANUMESH_GOOGLETEST_PROVIDER=auto",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=ON"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: mingw+ninja release sdk",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/mingw-ninja-release-sdk",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=gcc",
        "-DCMAKE_CXX_COMPILER=g++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DMANUMESH_GOOGLETEST_PROVIDER=auto",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=OFF",
        "-DMANUMESH_ENABLE_INSTALL=ON",
        "-DMANUMESH_INSTALL_CMAKE_CONFIG=ON"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: msvc selected",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/msvc-${input:msvcToolset}",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-T",
        "${input:msvcToolset}",
        "-DMANUMESH_GOOGLETEST_PROVIDER=source",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=OFF"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "configure: msvc selected performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/msvc-${input:msvcToolset}-performance",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-T",
        "${input:msvcToolset}",
        "-DMANUMESH_GOOGLETEST_PROVIDER=source",
        "-DMANUMESH_BUILD_PERFORMANCE_TESTS=ON"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "build: mingw+ninja debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-debug", "--parallel"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja debug"
    },
    {
      "label": "build: mingw+ninja release",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--parallel"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "build: mingw+ninja debug performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-debug-performance",
        "--target",
        "manumesh_performance_tests",
        "--parallel"
      ],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja debug performance"
    },
    {
      "label": "build: mingw+ninja release performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-release-performance",
        "--target",
        "manumesh_performance_tests",
        "--parallel"
      ],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release performance"
    },
    {
      "label": "test: mingw+ninja release sdk consumer",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-release-sdk",
        "--target",
        "sdk-consumer-test",
        "--parallel"
      ],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release sdk"
    },
    {
      "label": "build: msvc selected debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/msvc-${input:msvcToolset}",
        "--config",
        "Debug",
        "--parallel"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "dependsOn": "configure: msvc selected"
    },
    {
      "label": "build: msvc selected release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/msvc-${input:msvcToolset}",
        "--config",
        "Release",
        "--parallel"
      ],
      "problemMatcher": ["$msCompile"],
      "dependsOn": "configure: msvc selected"
    },
    {
      "label": "build: msvc selected debug performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/msvc-${input:msvcToolset}-performance",
        "--config",
        "Debug",
        "--target",
        "manumesh_performance_tests",
        "--parallel"
      ],
      "problemMatcher": ["$msCompile"],
      "dependsOn": "configure: msvc selected performance"
    },
    {
      "label": "build: msvc selected release performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/msvc-${input:msvcToolset}-performance",
        "--config",
        "Release",
        "--target",
        "manumesh_performance_tests",
        "--parallel"
      ],
      "problemMatcher": ["$msCompile"],
      "dependsOn": "configure: msvc selected performance"
    },
    {
      "label": "test: mingw+ninja debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/mingw-ninja-debug",
        "ctest",
        "-LE",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja debug"
    },
    {
      "label": "test: mingw+ninja release",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/mingw-ninja-release",
        "ctest",
        "-LE",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "test: mingw+ninja debug performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/mingw-ninja-debug-performance",
        "ctest",
        "-L",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja debug performance"
    },
    {
      "label": "test: mingw+ninja release performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/mingw-ninja-release-performance",
        "ctest",
        "-L",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release performance"
    },
    {
      "label": "test: msvc selected debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/msvc-${input:msvcToolset}",
        "ctest",
        "-C",
        "Debug",
        "-LE",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: msvc selected debug"
    },
    {
      "label": "test: msvc selected release",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/msvc-${input:msvcToolset}",
        "ctest",
        "-C",
        "Release",
        "-LE",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: msvc selected release"
    },
    {
      "label": "test: msvc selected debug performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/msvc-${input:msvcToolset}-performance",
        "ctest",
        "-C",
        "Debug",
        "-L",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: msvc selected debug performance"
    },
    {
      "label": "test: msvc selected release performance",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "chdir",
        "build/msvc-${input:msvcToolset}-performance",
        "ctest",
        "-C",
        "Release",
        "-L",
        "performance",
        "--output-on-failure"
      ],
      "problemMatcher": [],
      "dependsOn": "build: msvc selected release performance"
    },
    {
      "label": "test: mingw+ninja release full",
      "dependsOrder": "sequence",
      "dependsOn": [
        "test: mingw+ninja release",
        "test: mingw+ninja release performance",
        "test: mingw+ninja release sdk consumer",
        "check: format",
        "build: docs-api",
        "build: docs-internal"
      ],
      "problemMatcher": []
    },
    {
      "label": "test: msvc selected full",
      "dependsOrder": "sequence",
      "dependsOn": [
        "test: msvc selected debug",
        "test: msvc selected release",
        "test: msvc selected debug performance",
        "test: msvc selected release performance"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare: vscode demo output",
      "type": "process",
      "command": "cmake",
      "args": [
        "-E",
        "make_directory",
        "${workspaceFolder}/output/vscode_demo/ratio_sweep"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "demo: simplify standard selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "simplify",
        "${input:demoMesh}",
        "output/vscode_demo/standard.stl",
        "--method",
        "standard",
        "--ratio",
        "${input:demoRatio}",
        "--samples",
        "${input:demoSamples}",
        "--metrics-csv",
        "output/vscode_demo/standard_metrics.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: simplify feature curves selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "simplify",
        "${input:demoMesh}",
        "output/vscode_demo/feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--min-circular-feature-loop-vertices",
        "12",
        "--feature-graph-gap-ratio",
        "1.25",
        "--feature-graph-max-weak-spur-edges",
        "2",
        "--feature-component-min-confidence",
        "0.35",
        "--ratio",
        "${input:demoRatio}",
        "--samples",
        "${input:demoSamples}",
        "--metrics-csv",
        "output/vscode_demo/feature_curves_metrics.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: simplify normal tensor selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "simplify",
        "${input:demoMesh}",
        "output/vscode_demo/normal_tensor.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "normal-tensor",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "179",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--feature-graph-gap-ratio",
        "1.25",
        "--feature-graph-max-weak-spur-edges",
        "2",
        "--feature-component-min-confidence",
        "0.35",
        "--ratio",
        "${input:demoRatio}",
        "--samples",
        "${input:demoSamples}",
        "--metrics-csv",
        "output/vscode_demo/normal_tensor_metrics.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: feature report selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "feature-report",
        "${input:demoMesh}",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--feature-graph-gap-ratio",
        "1.25",
        "--feature-graph-max-weak-spur-edges",
        "2",
        "--feature-component-min-confidence",
        "0.35",
        "--csv",
        "output/vscode_demo/features.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: feature benchmark selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "feature-benchmark",
        "${input:demoMesh}",
        "${input:demoFeatureLabels}",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--feature-graph-gap-ratio",
        "1.25",
        "--feature-graph-max-weak-spur-edges",
        "2",
        "--feature-component-min-confidence",
        "0.35",
        "--csv",
        "output/vscode_demo/feature_benchmark.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: ratio sweep selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "ratio-sweep",
        "${input:demoMesh}",
        "output/vscode_demo/ratio_sweep",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--ratios",
        "${input:demoRatios}",
        "--samples",
        "${input:demoSamples}"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: mingw+ninja release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "run: feature validation",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "validate-features",
        "--ratio",
        "0.20",
        "--samples",
        "1000",
        "--output-dir",
        "tests/output/feature_curve_validation"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "run: external validation",
      "type": "process",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/manumesh.exe",
      "args": [
        "validate-external",
        "--input-dir",
        "tests/data/external/common_3d_test_models",
        "--ratio",
        "0.25",
        "--samples",
        "800",
        "--output-dir",
        "tests/output/external_model_validation"
      ],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "check: format",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-debug",
        "--target",
        "check-format",
        "--parallel"
      ],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja debug"
    },
    {
      "label": "format",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-debug",
        "--target",
        "format",
        "--parallel"
      ],
      "problemMatcher": [],
      "dependsOn": "configure: mingw+ninja debug"
    },
    {
      "label": "build: docs-api",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-release",
        "--target",
        "docs-api",
        "--parallel"
      ],
      "problemMatcher": [],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "build: docs-internal",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/mingw-ninja-release",
        "--target",
        "docs-internal",
        "--parallel"
      ],
      "problemMatcher": [],
      "dependsOn": "configure: mingw+ninja release"
    }
  ],
  "inputs": [
    {
      "id": "demoMesh",
      "type": "pickString",
      "description": "Demo mesh",
      "default": "tests/data/feature_fixtures/coaxial_hole_plate.obj",
      "options": [
        "tests/data/feature_fixtures/coaxial_hole_plate.obj",
        "tests/data/feature_fixtures/elliptical_hole_plate.obj",
        "tests/data/feature_fixtures/boss_pocket_plate.obj",
        "tests/data/feature_fixtures/near_circular_hole_plate.obj",
        "tests/data/external/fandisk_2014.stl",
        "tests/data/external/casting_aimshape_2014.stl"
      ]
    },
    {
      "id": "demoRatio",
      "type": "pickString",
      "description": "Target face ratio",
      "default": "0.25",
      "options": ["0.80", "0.50", "0.25", "0.20", "0.10"]
    },
    {
      "id": "demoRatios",
      "type": "promptString",
      "description": "Ratio sweep list",
      "default": "0.8,0.5,0.25,0.1"
    },
    {
      "id": "demoSamples",
      "type": "pickString",
      "description": "Sampled-distance count",
      "default": "512",
      "options": ["128", "512", "1000", "3000"]
    },
    {
      "id": "demoFeatureAngle",
      "type": "pickString",
      "description": "Feature angle in degrees",
      "default": "25",
      "options": ["15", "25", "35", "45", "179"]
    },
    {
      "id": "demoLoopTraceAngle",
      "type": "pickString",
      "description": "Loop trace angle in degrees (-1 reuses feature angle)",
      "default": "-1",
      "options": ["-1", "15", "25", "35", "45", "179"]
    },
    {
      "id": "demoFeatureLabels",
      "type": "pickString",
      "description": "Feature benchmark label CSV",
      "default": "tests/data/feature_labels/coaxial_hole_plate_inner_top_edges.csv",
      "options": [
        "tests/data/feature_labels/coaxial_hole_plate_inner_top_edges.csv"
      ]
    },
    {
      "id": "msvcToolset",
      "type": "pickString",
      "description": "MSVC toolset (v143 = VS2022, v142 = VS2019)",
      "default": "v143",
      "options": ["v143", "v142"]
    }
  ]
}
