    {
      "label": "run: feature validation",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/linequadrics.exe",
      "args": ["validate-features", "--ratio", "0.20", "--n", "96", "--samples", "1000"],
      "problemMatcher": [],
