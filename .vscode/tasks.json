    {
      "label": "verify: vs2019 release matrix",
      "dependsOn": [
        "test: vs2019 release full",
        "test: vs2019 release static",
        "test: vs2019 release static SDK",
        "test: vs2019 release performance",
        "test: vs2019 release SDK",
        "build: vs2019 release docs",
        "check: format"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: vscode demo output",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "make_directory", "output/vscode_demo"],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "demo: simplify selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "simplify",
        "${input:demoMesh}",
        "output/vscode_demo/simplified.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "normal-tensor",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--ratio",
        "${input:demoRatio}",
        "--samples",
        "${input:demoSamples}",
        "--metrics-csv",
        "output/vscode_demo/simplify_metrics.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: vs2019 release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: feature report selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "feature-report",
        "${input:demoMesh}",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--csv",
        "output/vscode_demo/features.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: vs2019 release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: feature benchmark selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "feature-benchmark",
        "${input:demoMesh}",
        "${input:demoFeatureLabels}",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:demoLoopTraceAngle}",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--csv",
        "output/vscode_demo/feature_benchmark.csv"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: vs2019 release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "demo: ratio sweep selected mesh",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "ratio-sweep",
        "${input:demoMesh}",
        "output/vscode_demo/ratio_sweep",
        "--method",
        "line",
        "--weight-mode",
        "normal-tensor",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:demoFeatureAngle}",
        "--ratios",
        "${input:demoRatios}",
        "--samples",
        "${input:demoSamples}"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "prepare: vscode demo output",
        "build: vs2019 release"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "run: feature validation",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "validate-features",
        "--ratio",
        "0.20",
        "--samples",
        "1000",
        "--output-dir",
        "tests/output/feature_curve_validation"
      ],
      "problemMatcher": [],
      "dependsOn": "build: vs2019 release"
    },
    {
      "label": "run: external validation",
      "type": "process",
      "command": "${workspaceFolder}/build/vs2019-release/bin/Release/manumesh.exe",
      "args": [
        "validate-external",
        "--input-dir",
        "tests/data/external/common_3d_test_models",
        "--ratio",
        "0.25",
        "--samples",
        "800",
        "--output-dir",
        "tests/output/external_model_validation"
      ],
      "problemMatcher": [],
      "dependsOn": "build: vs2019 release"
    },
    {
      "label": "check: format",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "vs2019-debug",
        "--target",
        "check-format",
        "--parallel"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "configure: vs2019 debug"
    },
    {
      "label": "format",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "vs2019-debug",
        "--target",
        "format",
        "--parallel"
      ],
      "problemMatcher": [],
      "dependsOn": "configure: vs2019 debug"
    }
  ],
  "inputs": [
    {
      "id": "demoMesh",
      "type": "pickString",
      "description": "演示网格",
      "default": "tests/data/feature_fixtures/coaxial_hole_plate.obj",
      "options": [
        "tests/data/feature_fixtures/coaxial_hole_plate.obj",
        "tests/data/feature_fixtures/elliptical_hole_plate.obj",
        "tests/data/feature_fixtures/boss_pocket_plate.obj",
        "tests/data/feature_fixtures/near_circular_hole_plate.obj",
        "tests/data/external/fandisk_2014.stl",
        "tests/data/external/casting_aimshape_2014.stl"
      ]
    },
    {
      "id": "demoFeatureLabels",
      "type": "pickString",
      "description": "特征基准标签 CSV",
      "default": "tests/data/feature_labels/coaxial_hole_plate_inner_top_edges.csv",
      "options": [
        "tests/data/feature_labels/coaxial_hole_plate_inner_top_edges.csv"
      ]
    },
    {
      "id": "demoRatio",
      "type": "pickString",
      "description": "目标面数比例",
      "default": "0.25",
      "options": ["0.80", "0.50", "0.25", "0.20", "0.10"]
    },
    {
      "id": "demoRatios",
      "type": "promptString",
      "description": "比例扫描列表",
      "default": "0.8,0.5,0.25,0.1"
    },
    {
      "id": "demoSamples",
      "type": "pickString",
      "description": "距离采样数量",
      "default": "512",
      "options": ["128", "512", "1000", "3000"]
    },
    {
      "id": "demoFeatureAngle",
      "type": "pickString",
      "description": "特征角度（度）",
      "default": "25",
      "options": ["15", "25", "35", "45", "179"]
    },
    {
      "id": "demoLoopTraceAngle",
      "type": "pickString",
      "description": "环追踪角度（度，-1 表示复用特征角度）",
      "default": "-1",
      "options": ["-1", "15", "25", "35", "45", "179"]
    }
  ]
}
