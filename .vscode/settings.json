{
  "cmake.useCMakePresets": "never",
  "cmake.configureOnOpen": false,
  "cmake.generator": "Ninja",
  "cmake.buildType": "Release",
  "cmake.buildDirectory": "${workspaceFolder}/build/mingw-ninja-release",
  "cmake.configureSettings": {
    "CMAKE_C_COMPILER": "gcc",
    "CMAKE_CXX_COMPILER": "g++",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
    "MANUMESH_GOOGLETEST_PROVIDER": "auto",
    "MANUMESH_BUILD_PERFORMANCE_TESTS": "OFF"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/mingw-ninja-release/compile_commands.json",
  "C_Cpp.default.compilerPath": "g++",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/src",
    "${workspaceFolder}/apps/manumesh",
    "${workspaceFolder}/thirdParty/eigen/include",
    "${workspaceFolder}/thirdParty/googletest/prebuilt/mingw-x64-shared/include"
  ],
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/src",
    "${workspaceFolder}/apps",
    "${workspaceFolder}/thirdParty/eigen/include",
    "${workspaceFolder}/thirdParty/googletest/prebuilt/mingw-x64-shared/include"
  ],
  "C_Cpp.errorSquiggles": "enabled",
  "files.associations": {
    "*.m": "matlab",
    "*.h": "cpp",
    "*.cpp": "cpp",
    "any": "cpp",
    "array": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "*.tcc": "cpp",
    "cctype": "cpp",
    "chrono": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "codecvt": "cpp",
    "compare": "cpp",
    "complex": "cpp",
    "concepts": "cpp",
    "condition_variable": "cpp",
    "csignal": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "list": "cpp",
    "map": "cpp",
    "set": "cpp",
    "unordered_map": "cpp",
    "unordered_set": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "optional": "cpp",
    "random": "cpp",
    "ratio": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "hash_map": "cpp",
    "fstream": "cpp",
    "future": "cpp",
    "initializer_list": "cpp",
    "iomanip": "cpp",
    "iosfwd": "cpp",
    "iostream": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "mutex": "cpp",
    "new": "cpp",
    "ostream": "cpp",
    "ranges": "cpp",
    "span": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "stop_token": "cpp",
    "streambuf": "cpp",
    "thread": "cpp",
    "cinttypes": "cpp",
    "typeinfo": "cpp",
    "valarray": "cpp",
    "variant": "cpp"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#4ac5e1",
    "activityBar.background": "#4ac5e1",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#db24b9",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#4ac5e1",
    "statusBar.background": "#23b4d5",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#1c8fa9",
    "statusBarItem.remoteBackground": "#23b4d5",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#23b4d5",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#23b4d599",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#23b4d5"
}
