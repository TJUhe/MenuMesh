{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-ninja-release",
      "displayName": "MinGW + Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-ninja-debug",
      "displayName": "MinGW + Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-makefiles-release",
      "displayName": "MinGW Makefiles Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw-makefiles-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-makefiles-debug",
      "displayName": "MinGW Makefiles Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw-makefiles-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-vs2022-release",
      "displayName": "MSVC Visual Studio 2022 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-vs2022-release",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-vs2022-debug",
      "displayName": "MSVC Visual Studio 2022 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-vs2022-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-ninja-release",
      "displayName": "MSVC + Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-ninja-debug",
      "displayName": "MSVC + Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-ninja-release",
      "configurePreset": "mingw-ninja-release"
    },
    {
      "name": "mingw-ninja-debug",
      "configurePreset": "mingw-ninja-debug"
    },
    {
      "name": "mingw-makefiles-release",
      "configurePreset": "mingw-makefiles-release"
    },
    {
      "name": "mingw-makefiles-debug",
      "configurePreset": "mingw-makefiles-debug"
    },
    {
      "name": "msvc-vs2022-release",
      "configurePreset": "msvc-vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-vs2022-debug",
      "configurePreset": "msvc-vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-ninja-release",
      "configurePreset": "msvc-ninja-release"
    },
    {
      "name": "msvc-ninja-debug",
      "configurePreset": "msvc-ninja-debug"
    }
  ]
}
