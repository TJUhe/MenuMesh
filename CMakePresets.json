      },
      "toolset": {
        "value": "v142",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /W3 /FS",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /W3 /GR /EHsc /FS",
