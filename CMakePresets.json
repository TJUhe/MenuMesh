        "stopOnFailure": false
      }
    },
    {
      "name": "vs2019-release-static-unit",
      "displayName": "Test VS2019 Release Static - fast suite",
      "configurePreset": "vs2019-release-static",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "label": "performance|external"
        }
      },
      "output": {
        "outputOnFailure": true
