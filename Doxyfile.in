# Doxyfile - ManuMesh API 和内部工程文档

#---------------------------------------------------------------------------
# 项目相关配置选项
#---------------------------------------------------------------------------
PROJECT_NAME           = "@MANUMESH_DOXYGEN_PROJECT_NAME@"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "@MANUMESH_DOXYGEN_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = @MANUMESH_DOXYGEN_OUTPUT_DIR@
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Chinese

#---------------------------------------------------------------------------
# 构建相关配置选项
#---------------------------------------------------------------------------
EXTRACT_ALL            = @MANUMESH_DOXYGEN_EXTRACT_ALL@
EXTRACT_PRIVATE        = @MANUMESH_DOXYGEN_EXTRACT_PRIVATE@
EXTRACT_STATIC         = @MANUMESH_DOXYGEN_EXTRACT_STATIC@
EXTRACT_LOCAL_CLASSES  = @MANUMESH_DOXYGEN_EXTRACT_LOCAL_CLASSES@
EXTRACT_ANON_NSPACES   = @MANUMESH_DOXYGEN_EXTRACT_ANON_NSPACES@
INTERNAL_DOCS          = @MANUMESH_DOXYGEN_INTERNAL_DOCS@
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
WARNINGS               = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_IF_UNDOCUMENTED   = @MANUMESH_DOXYGEN_WARN_IF_UNDOCUMENTED@
WARN_IF_DOC_ERROR      = YES
QUIET                  = NO

#---------------------------------------------------------------------------
# 与输入文件相关的配置选项
#---------------------------------------------------------------------------
INPUT                  = @MANUMESH_DOXYGEN_INPUT@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.md
FILE_PATTERNS         += *.dox
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */thirdParty/* */build/* */docs/* */documentation/archive/* */CMakeLists.txt */vcpkg.json
EXCLUDE_SYMBOLS        = std Eigen
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@

#---------------------------------------------------------------------------
# 与源码浏览相关的配置选项
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = @MANUMESH_DOXYGEN_INLINE_SOURCES@
STRIP_CODE_COMMENTS    = NO
SOURCE_TOOLTIPS        = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
ALPHABETICAL_INDEX     = YES

#---------------------------------------------------------------------------
# 与 HTML 输出相关的配置选项
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

#---------------------------------------------------------------------------
# 与 LaTeX 和 XML 输出相关的配置选项
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# 与预处理器相关的配置选项
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MANUMESH_API= \
                         MANUMESH_DISABLE_SIZE_AWARE_ALIASES=1 \
                         MANUMESH_ENABLE_DEBUG_UTIL=1 \
                         _WIN32=1 \
                         WIN32=1

#---------------------------------------------------------------------------
# 与 Graphviz dot 相关的配置选项
#---------------------------------------------------------------------------
HAVE_DOT               = @MANUMESH_DOXYGEN_HAVE_DOT@
DOT_PATH               = @MANUMESH_DOXYGEN_DOT_PATH@
DOT_NUM_THREADS        = 4
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
DOT_GRAPH_MAX_NODES    = 50
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

#---------------------------------------------------------------------------
# 其他选项
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
ALIASES               += algorithm="@par Algorithm"
ALIASES               += complexity="@par Complexity"
ALIASES               += invariants="@par Invariants"
ALIASES               += failuremodes="@par Failure modes"
TIMESTAMP              = YES
