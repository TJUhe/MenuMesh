<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="ManuMesh">
    <ManuMeshSdkRoot>$(MSBuildThisFileDirectory)..\..\..</ManuMeshSdkRoot>
    <ManuMeshSdkIncludeDir>$(ManuMeshSdkRoot)\include</ManuMeshSdkIncludeDir>
    <ManuMeshSdkLibraryDir>$(ManuMeshSdkRoot)\lib</ManuMeshSdkLibraryDir>
    <ManuMeshSdkRuntimeDir>$(ManuMeshSdkRoot)\bin</ManuMeshSdkRuntimeDir>
    <ManuMeshEigenIncludeDir Condition="'$(ManuMeshEigenIncludeDir)' == ''">$(ManuMeshSdkRoot)\share\manumesh\thirdParty\eigen\include</ManuMeshEigenIncludeDir>
  </PropertyGroup>

  <ItemGroup>
    <ManuMeshRuntimeDll Include="$(ManuMeshSdkRuntimeDir)\*.dll" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ManuMeshSdkIncludeDir);$(ManuMeshEigenIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ManuMeshSdkLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>manumesh.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="ManuMeshCopyRuntime"
          AfterTargets="Build"
          Condition="'@(ManuMeshRuntimeDll)' != ''">
    <Copy SourceFiles="@(ManuMeshRuntimeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
