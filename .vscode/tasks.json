{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure: mingw+ninja release",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build/mingw-ninja-release", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_C_COMPILER=gcc", "-DCMAKE_CXX_COMPILER=g++", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DLQ_BUILD_PERFORMANCE_TESTS=OFF"],
      "problemMatcher": []
    },
    {
      "label": "build: mingw+ninja release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--target", "linequadrics", "--parallel", "2"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "build: mingw+ninja release tests",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--target", "line_quadrics_qem_tests", "--parallel", "2"],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "build: mingw+ninja release all",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release", "--parallel", "2"],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release"
    },
    {
      "label": "configure: mingw+ninja release performance",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build/mingw-ninja-release-performance", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_C_COMPILER=gcc", "-DCMAKE_CXX_COMPILER=g++", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DLQ_BUILD_PERFORMANCE_TESTS=ON"],
      "problemMatcher": []
    },
    {
      "label": "build: mingw+ninja release performance tests",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/mingw-ninja-release-performance", "--target", "line_quadrics_qem_performance_tests", "--parallel", "2"],
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure: mingw+ninja release performance"
    },
