<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="ManuMesh">
    <ManuMeshSdkRoot>$(MSBuildThisFileDirectory)..\..\..</ManuMeshSdkRoot>
    <ManuMeshSdkIncludeDir>$(ManuMeshSdkRoot)\include</ManuMeshSdkIncludeDir>
    <ManuMeshSdkLibraryDir>$(ManuMeshSdkRoot)\lib</ManuMeshSdkLibraryDir>
    <ManuMeshSdkRuntimeDir>$(ManuMeshSdkRoot)\bin</ManuMeshSdkRuntimeDir>
    <ManuMeshSupportedPlatform>x64</ManuMeshSupportedPlatform>
    <ManuMeshSupportedPlatformToolset>v142</ManuMeshSupportedPlatformToolset>
    <ManuMeshSupportedVisualStudioVersion>16.0</ManuMeshSupportedVisualStudioVersion>
    <ManuMeshEigenIncludeDir Condition="'$(ManuMeshEigenIncludeDir)' == ''">$(ManuMeshSdkRoot)\share\manumesh\thirdParty\eigen\include</ManuMeshEigenIncludeDir>
    <ManuMeshCopyRuntimeDependencies Condition="'$(ManuMeshCopyRuntimeDependencies)' == ''">true</ManuMeshCopyRuntimeDependencies>
  </PropertyGroup>

  <ItemGroup>
    <ManuMeshRuntimeDll Include="$(ManuMeshSdkRuntimeDir)\*.dll" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp14</LanguageStandard>
      <AdditionalIncludeDirectories>$(ManuMeshSdkIncludeDir);$(ManuMeshEigenIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ManuMeshSdkLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>manumesh.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="ManuMeshValidatePlatformToolset"
          BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != '$(ManuMeshSupportedPlatform)'"
           Text="ManuMesh requires the x64 platform; current Platform is '$(Platform)'." />
    <Error Condition="'$(PlatformToolset)' != '$(ManuMeshSupportedPlatformToolset)'"
           Text="ManuMesh requires the Visual Studio 2019 v142 platform toolset; current PlatformToolset is '$(PlatformToolset)'." />
    <Error Condition="'$(VisualStudioVersion)' != '' and '$(VisualStudioVersion)' != '$(ManuMeshSupportedVisualStudioVersion)'"
           Text="ManuMesh requires Visual Studio 16 2019; current VisualStudioVersion is '$(VisualStudioVersion)'." />
  </Target>

  <Target Name="ManuMeshCopyRuntime"
          AfterTargets="Build"
          Condition="'$(ManuMeshCopyRuntimeDependencies)' == 'true' and '@(ManuMeshRuntimeDll)' != ''"
          Inputs="@(ManuMeshRuntimeDll)"
          Outputs="@(ManuMeshRuntimeDll->'$(OutDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(ManuMeshRuntimeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
