<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="LineQuadricsQem">
    <LQSdkRoot>$(MSBuildThisFileDirectory)..\..\..</LQSdkRoot>
    <LQSdkIncludeDir>$(LQSdkRoot)\include</LQSdkIncludeDir>
    <LQSdkLibraryDir>$(LQSdkRoot)\lib</LQSdkLibraryDir>
    <LQSdkRuntimeDir>$(LQSdkRoot)\bin</LQSdkRuntimeDir>
    <LQEigenIncludeDir Condition="'$(LQEigenIncludeDir)' == ''">$(LQSdkRoot)\share\line_quadrics_qem\thirdParty\eigen\include</LQEigenIncludeDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LQSdkIncludeDir);$(LQEigenIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(LQSdkLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>line_quadrics_qem.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="LineQuadricsQemCopyRuntime"
          AfterTargets="Build"
          Condition="Exists('$(LQSdkRuntimeDir)\line_quadrics_qem.dll')">
    <Copy SourceFiles="$(LQSdkRuntimeDir)\line_quadrics_qem.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
