{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI Standard QEM (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_standard.stl",
        "--method",
        "standard",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_standard_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug CLI Line QEM (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_line.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_line_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug CLI Feature Curves (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--min-circular-feature-loop-vertices",
        "12",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_feature_curves_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug CLI Industrial Safe (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_industrial_safe.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--max-local-error-ratio",
        "0.02",
        "--industrial-safe",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_industrial_safe_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug CLI Normal Tensor (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_normal_tensor.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "normal-tensor",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "179",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_normal_tensor_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug Feature Report (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/linequadrics.exe",
      "args": [
        "feature-report",
        "${input:launchMesh}",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--csv",
        "examples/output/vscode_debug_features.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "Debug Unit Tests Filter (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/line_quadrics_qem_tests.exe",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug tests"
    },
    {
      "name": "Debug Dataset Tests Filter (MinGW Ninja)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug-performance/bin/line_quadrics_qem_performance_tests.exe",
      "args": [
        "--gtest_filter=${input:performanceGtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug performance tests"
    },
    {
      "name": "Debug CLI Feature Curves (MSVC Ninja)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-ninja-debug/bin/linequadrics.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "examples/output/vscode_debug_msvc_feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "examples/output/vscode_debug_msvc_feature_curves_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+ninja debug"
    },
    {
      "name": "Debug Unit Tests Filter (MSVC Ninja)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-ninja-debug/bin/line_quadrics_qem_tests.exe",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+ninja debug tests"
    }
  ],
  "inputs": [
    {
      "id": "launchMesh",
      "type": "pickString",
      "description": "Debug mesh",
      "default": "tests/data/feature_fixtures/coaxial_hole_plate.obj",
      "options": [
        "tests/data/feature_fixtures/coaxial_hole_plate.obj",
        "tests/data/feature_fixtures/elliptical_hole_plate.obj",
        "tests/data/feature_fixtures/boss_pocket_plate.obj",
        "tests/data/feature_fixtures/near_circular_hole_plate.obj",
        "tests/data/external/fandisk_2014.stl",
        "tests/data/external/casting_aimshape_2014.stl",
        "examples/input/pipe_coupling.stl",
        "examples/input/flange_curve.stl",
        "examples/input/pulley.stl",
        "examples/input/stepped_shaft.stl"
      ]
    },
    {
      "id": "launchRatio",
      "type": "pickString",
      "description": "Target face ratio",
      "default": "0.25",
      "options": ["0.80", "0.50", "0.25", "0.20", "0.10"]
    },
    {
      "id": "launchSamples",
      "type": "pickString",
      "description": "Sampled-distance count",
      "default": "512",
      "options": ["128", "512", "1000", "3000"]
    },
    {
      "id": "launchFeatureAngle",
      "type": "pickString",
      "description": "Feature angle in degrees",
      "default": "25",
      "options": ["15", "25", "35", "45", "179"]
    },
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "GoogleTest filter",
      "default": "LineQuadricsQemParameters.*"
    },
    {
      "id": "performanceGtestFilter",
      "type": "promptString",
      "description": "Dataset GoogleTest filter",
      "default": "LineQuadricsQemDataset.*"
    }
  ]
}
