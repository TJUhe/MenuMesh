        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "vs2019-release-full",
      "displayName": "Test VS2019 Release - all configured tests",
      "configurePreset": "vs2019-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
