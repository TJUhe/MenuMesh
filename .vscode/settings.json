{
  "cmake.useCMakePresets": "never",
  "cmake.configureOnOpen": false,
  "cmake.generator": "Ninja",
  "cmake.buildType": "Release",
  "cmake.buildDirectory": "${workspaceFolder}/build/mingw-ninja-${buildType}",
  "cmake.configureSettings": {
    "CMAKE_CXX_COMPILER": "g++",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
  },
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/mingw-ninja-release",
    "--query-driver=**/g++.exe,**/gcc.exe,**/mingw64/bin/*.exe,**/mingw32/bin/*.exe",
    "--background-index",
    "--header-insertion=never"
  ],
  "clangd.fallbackFlags": [
    "-std=c++17",
    "-I${workspaceFolder}/include",
    "-I${workspaceFolder}/src",
    "-I${workspaceFolder}/thirdParty/googletest/googletest/include",
    "-isystem",
    "${workspaceFolder}/build/_deps/eigen-src"
  ],
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++17",
  "files.associations": {
    "*.h": "cpp",
    "*.cpp": "cpp"
  }
}
