PROJECT_NAME           = "ManuMesh"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "面向增材制造的多边形网格几何内核"
OUTPUT_DIRECTORY       = @LQ_DOXYGEN_OUTPUT_DIR@
INPUT                  = @LQ_DOXYGEN_INPUT@
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
WARN_AS_ERROR          = NO
WARN_IF_UNDOCUMENTED   = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @CMAKE_CURRENT_SOURCE_DIR@
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/README.md
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = LQ_API=
QUIET                  = NO
