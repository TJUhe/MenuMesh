{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(MinGW Ninja) Debug CLI Feature Curves",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/manumesh.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "output/vscode_debug_feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:launchLoopTraceAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--min-circular-feature-loop-vertices",
        "12",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "output/vscode_debug_feature_curves_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "(MinGW Ninja) Debug CLI Feature Report",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/manumesh.exe",
      "args": [
        "feature-report",
        "${input:launchMesh}",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:launchLoopTraceAngle}",
        "--circle-fit-threshold",
        "0.04",
        "--ellipse-fit-threshold",
        "0.05",
        "--normal-tensor-threshold",
        "0.06",
        "--normal-tensor-edge-alignment",
        "0.2",
        "--normal-tensor-scales",
        "3",
        "--normal-tensor-min-persistent-scales",
        "2",
        "--csv",
        "output/vscode_debug_features.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug"
    },
    {
      "name": "(MinGW Ninja) Debug Unit Tests Filter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug/bin/manumesh_tests.exe",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug tests"
    },
    {
      "name": "(MinGW Ninja) Debug Performance Tests Filter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-ninja-debug-performance/bin/manumesh_performance_tests.exe",
      "args": [
        "--gtest_filter=${input:performanceGtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "build: mingw+ninja debug performance tests"
    },
    {
      "name": "(MSVC VS2022) Debug CLI Feature Curves",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-vs2022/bin/Debug/manumesh.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "output/vscode_debug_msvc_feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:launchLoopTraceAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "output/vscode_debug_msvc_feature_curves_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+vs2022 debug"
    },
    {
      "name": "(MSVC VS2022) Debug Unit Tests Filter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-vs2022/bin/Debug/manumesh_tests.exe",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+vs2022 debug tests"
    },
    {
      "name": "(MSVC VS2019) Debug CLI Feature Curves",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-vs2019/bin/Debug/manumesh.exe",
      "args": [
        "simplify",
        "${input:launchMesh}",
        "output/vscode_debug_msvc2019_feature_curves.stl",
        "--method",
        "line",
        "--line-weight",
        "1e-3",
        "--weight-mode",
        "dihedral",
        "--feature-boost",
        "0.08",
        "--feature-angle-deg",
        "${input:launchFeatureAngle}",
        "--loop-trace-angle-deg",
        "${input:launchLoopTraceAngle}",
        "--preserve-feature-curves",
        "--feature-curve-weight",
        "0.08",
        "--max-feature-curve-deviation-ratio",
        "0.05",
        "--ratio",
        "${input:launchRatio}",
        "--samples",
        "${input:launchSamples}",
        "--metrics-csv",
        "output/vscode_debug_msvc2019_feature_curves_metrics.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+vs2019 debug"
    },
    {
      "name": "(MSVC VS2019) Debug Unit Tests Filter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-vs2019/bin/Debug/manumesh_tests.exe",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_color=yes"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "build: msvc+vs2019 debug tests"
    }
  ],
  "inputs": [
    {
      "id": "launchMesh",
      "type": "pickString",
      "description": "Debug mesh",
      "default": "tests/data/feature_fixtures/coaxial_hole_plate.obj",
      "options": [
        "tests/data/feature_fixtures/coaxial_hole_plate.obj",
        "tests/data/feature_fixtures/elliptical_hole_plate.obj",
        "tests/data/feature_fixtures/boss_pocket_plate.obj",
        "tests/data/feature_fixtures/near_circular_hole_plate.obj",
        "tests/data/external/fandisk_2014.stl",
        "tests/data/external/casting_aimshape_2014.stl"
      ]
    },
    {
      "id": "launchRatio",
      "type": "pickString",
      "description": "Target face ratio",
      "default": "0.25",
      "options": ["0.80", "0.50", "0.25", "0.20", "0.10"]
    },
    {
      "id": "launchSamples",
      "type": "pickString",
      "description": "Sampled-distance count",
      "default": "512",
      "options": ["128", "512", "1000", "3000"]
    },
    {
      "id": "launchFeatureAngle",
      "type": "pickString",
      "description": "Feature angle in degrees",
      "default": "25",
      "options": ["15", "25", "35", "45", "179"]
    },
    {
      "id": "launchLoopTraceAngle",
      "type": "pickString",
      "description": "Loop trace angle in degrees (-1 reuses feature angle)",
      "default": "-1",
      "options": ["-1", "15", "25", "35", "45", "179"]
    },
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "GoogleTest filter",
      "default": "ManuMeshParameters.*"
    },
    {
      "id": "performanceGtestFilter",
      "type": "promptString",
      "description": "Dataset GoogleTest filter",
      "default": "ManuMeshDataset.*"
    }
  ]
}
