      "label": "install: mingw+ninja release",
      "type": "shell",
      "command": "cmake",
      "args": ["--install", "build/mingw-ninja-release", "--prefix", "${workspaceFolder}\\install\\mingw-ninja-release"],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release all"
    }
