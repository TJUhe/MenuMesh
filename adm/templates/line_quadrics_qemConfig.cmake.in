@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(LINE_QUADRICS_QEM_EIGEN_INCLUDE_DIR
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/line_quadrics_qem/thirdParty/eigen/include"
)
if(NOT TARGET Eigen3::Eigen)
  if(EXISTS "${LINE_QUADRICS_QEM_EIGEN_INCLUDE_DIR}/Eigen/Core")
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${LINE_QUADRICS_QEM_EIGEN_INCLUDE_DIR}"
    )
  else()
    find_dependency(Eigen3 3.3 NO_MODULE)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/line_quadrics_qemTargets.cmake")

set(LINE_QUADRICS_QEM_SHARED @LQ_BUILD_SHARED_LIBRARY@)
set(LINE_QUADRICS_QEM_MSVC_PROPS
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/line_quadrics_qem/msvc/line_quadrics_qem.props"
)

function(line_quadrics_qem_copy_runtime_dependencies target)
  if(WIN32 AND LINE_QUADRICS_QEM_SHARED AND TARGET line_quadrics_qem::line_quadrics_qem)
    add_custom_command(TARGET ${target} POST_BUILD
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "$<TARGET_FILE:line_quadrics_qem::line_quadrics_qem>"
        "$<TARGET_FILE_DIR:${target}>"
      COMMENT "Copying line_quadrics_qem runtime library next to ${target}"
      VERBATIM
    )
  endif()
endfunction()
