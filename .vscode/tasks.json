    {
      "label": "run: quick demo data",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-ninja-release/bin/linequadrics.exe",
      "args": ["demo", "--quick", "--samples", "500"],
      "problemMatcher": [],
      "dependsOn": "build: mingw+ninja release"
    },
    {
      "label": "run: quick demo data (mingw makefiles)",
      "type": "shell",
      "command": "${workspaceFolder}/build/mingw-makefiles-release/bin/linequadrics.exe",
